# Copy this file to /configs/.env and fill in real values (previously in /src/services/firebaseConfig.ts).
# All variables prefixed with VITE_ will be exposed to the Vite client bundle.

# Firebase Web SDK config
# Project Settings > General > Your apps > Web app SDK setup
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Calendar OAuth client (Web)
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
