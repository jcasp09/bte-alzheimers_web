rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only the authenticated owner can access their graph node photos.
    match /users/{uid}/graphs/{graphId}/nodes/{nodeId}/photo {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // Deny all other storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
